# ============================================
# KasaManager .gitignore
# ============================================

# Build outputs
bin/
obj/
publish/
out/

# User / IDE
.vs/
*.user
*.suo
*.csproj.user
.idea/
*.swp
*~

# NuGet
packages/
*.nupkg

# Logs
logs/
*.log

# Secrets — gerçek değerler Development dosyasında
appsettings.Development.json
secrets.json

# Machine-specific production config — must never enter generic publish output.
# Currently still Git-tracked; untracking (git rm --cached) is a separate,
# deliberate step, not performed here.
src/KasaManager.Web/appsettings.Production.json

# Upload / Cache / Temp
**/wwwroot/Data/Raporlar/
cache/
temp/
/tmp/

# OS
Thumbs.db
.DS_Store
desktop.ini

# Test results
TestResults/
coverage/
*.trx

# Rider / JetBrains
.idea/
*.sln.iml

# Repository whitelist (the broad rule is intentional)
*

# Test project C# sources; keep generated artifacts ignored
!tests/
!tests/KasaManager.Tests/
!tests/KasaManager.Tests/**/
!tests/KasaManager.Tests/**/*.cs
tests/KasaManager.Tests/**/bin/
tests/KasaManager.Tests/**/obj/

