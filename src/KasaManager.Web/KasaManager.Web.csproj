<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KasaManager.Web</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\KasaManager.Application\KasaManager.Application.csproj" />
    <ProjectReference Include="..\KasaManager.Infrastructure\KasaManager.Infrastructure.csproj" />
    <ProjectReference Include="..\KasaManager.Domain\KasaManager.Domain.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Release publish hygiene: appsettings.Development.json/appsettings.Test.json must stay in the
       source project (Debug build/run behavior unaffected) but must never ship in a Release publish
       artifact. Microsoft.NET.Sdk.Web's StaticWebAssets glob includes these as Content items with
       CopyToPublishDirectory=PreserveNewest by default (verified via `dotnet msbuild -getItem:Content`) —
       overriding just that metadata for Release keeps appsettings.json/appsettings.Production.json unaffected. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
    <Content Update="appsettings.Test.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
